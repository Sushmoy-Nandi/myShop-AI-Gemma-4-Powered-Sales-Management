# Google AI Studio (Gemma 4) - Required
GOOGLE_AI_STUDIO_KEY="your_google_ai_studio_api_key_here"

# Primary model (default: gemma-4-31b-it)
GEMMA_MODEL="gemma-4-31b-it"

# Optional Integrations
# To enable Automated Daily AI Emails via Google Apps Script
APPSCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"

